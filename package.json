{
  "name": "releaseguard",
  "version": "0.1.0",
  "private": true,
  "description": "A reproducible release engineering and incident response lab",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "demo": "node --env-file=.env.demo dist/main.js",
    "test": "npm run build && node --test dist/tests/*.test.js tests/*.test.mjs",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "ioredis": "^5.6.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.8.0"
  }
}
