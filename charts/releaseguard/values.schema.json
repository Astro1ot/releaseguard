{
  "$schema":"https://json-schema.org/draft-07/schema#", "type":"object", "additionalProperties":false,
  "required":["replicaCount","image","app","resources","service","ingress","lab","networkPolicy"],
  "properties":{
    "replicaCount":{"type":"integer","minimum":1,"maximum":10},
    "image":{"type":"object","additionalProperties":false,"required":["repository","tag","pullPolicy"],"properties":{"repository":{"type":"string","minLength":1},"tag":{"type":"string","minLength":1,"not":{"enum":["latest"]}},"pullPolicy":{"enum":["Always","IfNotPresent","Never"]}}},
